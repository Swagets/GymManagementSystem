<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gymapp.controllers.MenuClienteController"
            style="-fx-background-color:#121212;">

    <children>

        <VBox layoutX="40"
              layoutY="20"
              prefWidth="520"
              prefHeight="510"
              spacing="10"
              style="
              -fx-background-color:#1E1E1E;
              -fx-background-radius:15;
              -fx-padding:25;
              -fx-effect:dropshadow(gaussian, black, 15, 0.5, 0, 5);">


            <Label text="MENÚ DEL CLIENTE"
                   alignment="CENTER"
                   maxWidth="500"
                   style="
                   -fx-text-fill:#E63946;
                   -fx-font-size:24px;
                   -fx-font-weight:bold;"/>


            <Label text="Bienvenido"
                   alignment="CENTER"
                   maxWidth="500"
                   style="
                   -fx-text-fill:white;
                   -fx-font-size:16px;"/>


            <Label fx:id="lblBienvenida"
                   text=""
                   alignment="CENTER"
                   maxWidth="500"
                   style="
                   -fx-text-fill:#E63946;
                   -fx-font-size:18px;
                   -fx-font-weight:bold;"/>


            <Separator/>


            <Label text="DATOS PERSONALES"
                   style="
                   -fx-text-fill:white;
                   -fx-font-size:17px;
                   -fx-font-weight:bold;"/>


            <HBox spacing="20">
                <Label text="Nombre:"
                       style="-fx-text-fill:#AAAAAA;"/>
                <Label fx:id="lblNombre"
                       text=""
                       style="-fx-text-fill:white;"/>
            </HBox>


            <HBox spacing="20">
                <Label text="Edad:"
                       style="-fx-text-fill:#AAAAAA;"/>
                <Label fx:id="lblEdad"
                       text=""
                       style="-fx-text-fill:white;"/>
            </HBox>


            <HBox spacing="20">
                <Label text="Peso:"
                       style="-fx-text-fill:#AAAAAA;"/>
                <Label fx:id="lblPeso"
                       text=""
                       style="-fx-text-fill:white;"/>
            </HBox>


            <Separator/>


            <Label text="RUTINA ASIGNADA"
                   style="
                   -fx-text-fill:white;
                   -fx-font-size:17px;
                   -fx-font-weight:bold;"/>


            <HBox spacing="20">
                <Label text="Rutina:"
                       style="-fx-text-fill:#AAAAAA;"/>
                <Label fx:id="lblRutina"
                       text=""
                       style="-fx-text-fill:white;"/>
            </HBox>


            <HBox spacing="20">
                <Label text="Objetivo:"
                       style="-fx-text-fill:#AAAAAA;"/>
                <Label fx:id="lblObjetivo"
                       text=""
                       style="-fx-text-fill:white;"/>
            </HBox>


            <HBox spacing="20">
                <Label text="Duración:"
                       style="-fx-text-fill:#AAAAAA;"/>
                <Label fx:id="lblDuracion"
                       text=""
                       style="-fx-text-fill:white;"/>
            </HBox>


            <HBox spacing="20">
                <Label text="Fecha Inicio:"
                       style="-fx-text-fill:#AAAAAA;"/>
                <Label fx:id="lblInicio"
                       text=""
                       style="-fx-text-fill:white;"/>
            </HBox>


            <HBox spacing="20">
                <Label text="Fecha Fin:"
                       style="-fx-text-fill:#AAAAAA;"/>
                <Label fx:id="lblFin"
                       text=""
                       style="-fx-text-fill:white;"/>
            </HBox>


            <HBox spacing="20">
                <Label text="Estado:"
                       style="-fx-text-fill:#AAAAAA;"/>
                <Label fx:id="lblEstado"
                       text=""
                       style="-fx-text-fill:white;"/>
            </HBox>


            <Button text="Cerrar Sesión"
                    maxWidth="200"
                    alignment="CENTER"
                    onAction="#logout"
                    style="
                    -fx-background-color:#E63946;
                    -fx-text-fill:white;
                    -fx-font-weight:bold;
                    -fx-background-radius:8;
                    -fx-cursor:hand;"/>


        </VBox>

    </children>

</AnchorPane>