<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>

<Pane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gymapp.controllers.RutinasController">

    <children>

        <Label layoutX="200.0" layoutY="20.0" style="-fx-font-size:18px; -fx-font-weight:bold;" text="GESTIÓN DE RUTINAS" />

        <Label layoutX="30.0" layoutY="70.0" text="Nombre" />

        <TextField fx:id="txtNombre" layoutX="30.0" layoutY="90.0" prefWidth="220" />

        <Label layoutX="30.0" layoutY="130.0" text="Objetivo" />

        <TextField fx:id="txtObjetivo" layoutX="30.0" layoutY="150.0" prefWidth="220" />

        <Label layoutX="30.0" layoutY="190.0" text="Duración (días)" />

        <TextField fx:id="txtDuracion" layoutX="30.0" layoutY="210.0" prefWidth="100" />

        <Button layoutX="30.0" layoutY="260.0" onAction="#guardarRutina" text="Guardar" />

        <Button layoutX="120.0" layoutY="260.0" onAction="#actualizarRutina" text="Actualizar" />

        <Button layoutX="235.0" layoutY="260.0" onAction="#eliminarRutina" text="Eliminar" />

        <Label layoutX="180.0" layoutY="310.0" style="-fx-font-weight:bold;" text="Tabla de Rutinas" />

        <TableView fx:id="tablaRutinas" layoutX="20.0" layoutY="340.0" prefHeight="140.0" prefWidth="560.0">

            <columns>

                <TableColumn fx:id="colId" prefWidth="60" text="ID" />

                <TableColumn fx:id="colNombre" prefWidth="170" text="Nombre" />

                <TableColumn fx:id="colObjetivo" prefWidth="210" text="Objetivo" />

                <TableColumn fx:id="colDuracion" prefWidth="110" text="Duración" />

            </columns>

        </TableView>

    </children>

</Pane>
