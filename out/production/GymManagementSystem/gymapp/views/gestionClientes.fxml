<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane prefHeight="550.0" prefWidth="650.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gymapp.controllers.ClientesController"
      style="-fx-background-color:#121212;">

    <children>

        <VBox layoutX="25"
              layoutY="20"
              prefWidth="600"
              prefHeight="510"
              spacing="15"
              style="
              -fx-background-color:#1E1E1E;
              -fx-background-radius:15;
              -fx-padding:25;
              -fx-effect:dropshadow(gaussian, black, 15, 0.5, 0, 5);">


            <Label text="GESTIÓN DE CLIENTES"
                   alignment="CENTER"
                   maxWidth="600"
                   style="
                   -fx-text-fill:#E63946;
                   -fx-font-size:24px;
                   -fx-font-weight:bold;"/>



            <HBox spacing="40">


                <!-- DATOS PERSONALES -->

                <VBox spacing="8">

                    <Label text="Nombre"
                           style="-fx-text-fill:#AAAAAA;"/>

                    <TextField fx:id="txtNombre"
                               prefWidth="230"
                               promptText="Nombre del cliente"
                               style="
                               -fx-background-color:#2B2B2B;
                               -fx-text-fill:white;
                               -fx-prompt-text-fill:#888888;
                               -fx-background-radius:8;
                               -fx-border-color:#E63946;
                               -fx-border-radius:8;"/>


                    <Label text="Edad"
                           style="-fx-text-fill:#AAAAAA;"/>

                    <TextField fx:id="txtEdad"
                               prefWidth="120"
                               promptText="Edad"
                               style="
                               -fx-background-color:#2B2B2B;
                               -fx-text-fill:white;
                               -fx-prompt-text-fill:#888888;
                               -fx-background-radius:8;
                               -fx-border-color:#E63946;
                               -fx-border-radius:8;"/>


                    <Label text="Peso (kg)"
                           style="-fx-text-fill:#AAAAAA;"/>

                    <TextField fx:id="txtPeso"
                               prefWidth="120"
                               promptText="Peso"
                               style="
                               -fx-background-color:#2B2B2B;
                               -fx-text-fill:white;
                               -fx-prompt-text-fill:#888888;
                               -fx-background-radius:8;
                               -fx-border-color:#E63946;
                               -fx-border-radius:8;"/>

                </VBox>




                <!-- DATOS LOGIN -->

                <VBox spacing="8">


                    <Label text="Usuario"
                           style="-fx-text-fill:#AAAAAA;"/>

                    <TextField fx:id="txtUsuario"
                               prefWidth="230"
                               promptText="Usuario"
                               style="
                               -fx-background-color:#2B2B2B;
                               -fx-text-fill:white;
                               -fx-prompt-text-fill:#888888;
                               -fx-background-radius:8;
                               -fx-border-color:#E63946;
                               -fx-border-radius:8;"/>


                    <Label text="Contraseña"
                           style="-fx-text-fill:#AAAAAA;"/>


                    <PasswordField fx:id="txtPassword"
                                   prefWidth="230"
                                   promptText="Contraseña"
                                   style="
                                   -fx-background-color:#2B2B2B;
                                   -fx-text-fill:white;
                                   -fx-prompt-text-fill:#888888;
                                   -fx-background-radius:8;
                                   -fx-border-color:#E63946;
                                   -fx-border-radius:8;"/>


                </VBox>


            </HBox>



            <!-- BOTONES -->

            <HBox spacing="15">

                <Button text="Guardar"
                        onAction="#guardarCliente"
                        prefWidth="120"
                        style="
                        -fx-background-color:#E63946;
                        -fx-text-fill:white;
                        -fx-font-weight:bold;
                        -fx-background-radius:8;
                        -fx-cursor:hand;"/>


                <Button text="Actualizar"
                        onAction="#actualizarCliente"
                        prefWidth="120"
                        style="
                        -fx-background-color:#E63946;
                        -fx-text-fill:white;
                        -fx-font-weight:bold;
                        -fx-background-radius:8;
                        -fx-cursor:hand;"/>


                <Button text="Eliminar"
                        onAction="#eliminarCliente"
                        prefWidth="120"
                        style="
                        -fx-background-color:#333333;
                        -fx-text-fill:white;
                        -fx-font-weight:bold;
                        -fx-background-radius:8;
                        -fx-cursor:hand;"/>


                <Button text="Limpiar"
                        onAction="#limpiarCampos"
                        prefWidth="120"
                        style="
                        -fx-background-color:#333333;
                        -fx-text-fill:white;
                        -fx-font-weight:bold;
                        -fx-background-radius:8;
                        -fx-cursor:hand;"/>

            </HBox>



            <Separator/>


            <Label text="TABLA DE CLIENTES"
                   alignment="CENTER"
                   maxWidth="600"
                   style="
                   -fx-text-fill:white;
                   -fx-font-size:17px;
                   -fx-font-weight:bold;"/>



            <TableView fx:id="tablaClientes"
                       prefHeight="170"
                       prefWidth="560"
                       style="
                       -fx-background-color:#2B2B2B;
                       -fx-border-color:#E63946;
                       -fx-border-radius:8;">


                <columns>


                    <TableColumn fx:id="colId"
                                 prefWidth="60"
                                 text="ID"/>


                    <TableColumn fx:id="colNombre"
                                 prefWidth="220"
                                 text="Nombre"/>


                    <TableColumn fx:id="colEdad"
                                 prefWidth="120"
                                 text="Edad"/>


                    <TableColumn fx:id="colPeso"
                                 prefWidth="160"
                                 text="Peso"/>


                </columns>


            </TableView>


        </VBox>


    </children>

</Pane>