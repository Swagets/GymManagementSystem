<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>

<Pane prefHeight="550.0" prefWidth="600.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gymapp.controllers.ClientesController">

    <children>

        <Label layoutX="190.0"
               layoutY="20.0"
               text="GESTIÓN DE CLIENTES"
               style="-fx-font-size:18px; -fx-font-weight:bold;"/>


        <!-- DATOS DEL CLIENTE -->

        <Label layoutX="30.0"
               layoutY="65.0"
               text="Nombre"/>

        <TextField fx:id="txtNombre"
                   layoutX="30.0"
                   layoutY="85.0"
                   prefWidth="220"/>


        <Label layoutX="30.0"
               layoutY="120.0"
               text="Edad"/>

        <TextField fx:id="txtEdad"
                   layoutX="30.0"
                   layoutY="140.0"
                   prefWidth="100"/>


        <Label layoutX="30.0"
               layoutY="175.0"
               text="Peso (kg)"/>

        <TextField fx:id="txtPeso"
                   layoutX="30.0"
                   layoutY="195.0"
                   prefWidth="100"/>



        <!-- DATOS DE LOGIN -->

        <Label layoutX="300.0"
               layoutY="65.0"
               text="Usuario"/>

        <TextField fx:id="txtUsuario"
                   layoutX="300.0"
                   layoutY="85.0"
                   prefWidth="220"/>


        <Label layoutX="300.0"
               layoutY="120.0"
               text="Contraseña"/>

        <PasswordField fx:id="txtPassword"
                       layoutX="300.0"
                       layoutY="140.0"
                       prefWidth="220"/>



        <!-- BOTONES -->

        <Button layoutX="30.0"
                layoutY="250.0"
                text="Guardar"
                onAction="#guardarCliente"/>

        <Button layoutX="120.0"
                layoutY="250.0"
                text="Actualizar"
                onAction="#actualizarCliente"/>

        <Button layoutX="235.0"
                layoutY="250.0"
                text="Eliminar"
                onAction="#eliminarCliente"/>

        <Button layoutX="340.0"
                layoutY="250.0"
                text="Limpiar"
                onAction="#limpiarCampos"/>



        <Label layoutX="215.0"
               layoutY="305.0"
               text="TABLA DE CLIENTES"
               style="-fx-font-weight:bold;"/>


        <TableView fx:id="tablaClientes"
                   layoutX="20.0"
                   layoutY="330.0"
                   prefHeight="180.0"
                   prefWidth="560.0">

            <columns>

                <TableColumn fx:id="colId"
                             prefWidth="60"
                             text="ID"/>

                <TableColumn fx:id="colNombre"
                             prefWidth="220"
                             text="Nombre"/>

                <TableColumn fx:id="colEdad"
                             prefWidth="120"
                             text="Edad"/>

                <TableColumn fx:id="colPeso"
                             prefWidth="160"
                             text="Peso"/>

            </columns>

        </TableView>

    </children>

</Pane>