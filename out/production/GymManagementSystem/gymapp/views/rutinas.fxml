<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="gymapp.controllers.RutinasController">
    <top>
        <ToolBar>
            <Button text="Agregar" onAction="#agregarRutina"/>
            <Button text="Editar" onAction="#editarRutina"/>
            <Button text="Eliminar" onAction="#eliminarRutina"/>
            <Button text="Refrescar" onAction="#cargarRutinas"/>
        </ToolBar>
    </top>
    <center>
        <TableView fx:id="tablaRutinas">
            <columns>
                <TableColumn fx:id="colId" text="ID"/>
                <TableColumn fx:id="colNombre" text="Nombre"/>
                <TableColumn fx:id="colObjetivo" text="Objetivo"/>
                <TableColumn fx:id="colDuracion" text="Duración (min)"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
