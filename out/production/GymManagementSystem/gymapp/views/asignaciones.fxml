<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane prefHeight="550.0"
      prefWidth="700.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gymapp.controllers.AsignacionesController"
      style="-fx-background-color:#121212;">

    <children>


        <VBox layoutX="25"
              layoutY="20"
              prefWidth="650"
              prefHeight="510"
              spacing="15"
              style="
              -fx-background-color:#1E1E1E;
              -fx-background-radius:15;
              -fx-padding:25;
              -fx-effect:dropshadow(gaussian, black, 15, 0.5, 0, 5);">


            <Label text="ASIGNACIÓN DE RUTINAS"
                   alignment="CENTER"
                   maxWidth="650"
                   style="
                   -fx-text-fill:#E63946;
                   -fx-font-size:24px;
                   -fx-font-weight:bold;"/>



            <HBox spacing="50">


                <VBox spacing="10">


                    <Label text="Cliente"
                           style="-fx-text-fill:#AAAAAA;"/>

                    <ComboBox fx:id="cmbCliente"
                              prefWidth="220"
                              promptText="Seleccione cliente"
                              style="
                              -fx-background-color:#2B2B2B;
                              -fx-text-fill:white;
                              -fx-border-color:#E63946;
                              -fx-border-radius:8;
                              -fx-background-radius:8;"/>



                    <Label text="Rutina"
                           style="-fx-text-fill:#AAAAAA;"/>


                    <ComboBox fx:id="cmbRutina"
                              prefWidth="220"
                              promptText="Seleccione rutina"
                              style="
                              -fx-background-color:#2B2B2B;
                              -fx-text-fill:white;
                              -fx-border-color:#E63946;
                              -fx-border-radius:8;
                              -fx-background-radius:8;"/>



                    <Label text="Estado"
                           style="-fx-text-fill:#AAAAAA;"/>


                    <ComboBox fx:id="cmbEstado"
                              prefWidth="220"
                              promptText="Estado"
                              style="
                              -fx-background-color:#2B2B2B;
                              -fx-text-fill:white;
                              -fx-border-color:#E63946;
                              -fx-border-radius:8;
                              -fx-background-radius:8;"/>


                </VBox>





                <VBox spacing="10">


                    <Label text="Fecha Inicio"
                           style="-fx-text-fill:#AAAAAA;"/>


                    <DatePicker fx:id="dpInicio"
                                prefWidth="220"
                                style="
                                -fx-background-color:#2B2B2B;
                                -fx-border-color:#E63946;
                                -fx-border-radius:8;"/>



                    <Label text="Fecha Fin"
                           style="-fx-text-fill:#AAAAAA;"/>


                    <DatePicker fx:id="dpFin"
                                prefWidth="220"
                                style="
                                -fx-background-color:#2B2B2B;
                                -fx-border-color:#E63946;
                                -fx-border-radius:8;"/>


                </VBox>


            </HBox>




            <HBox spacing="15">


                <Button text="Asignar"
                        onAction="#guardarAsignacion"
                        prefWidth="120"
                        style="
                        -fx-background-color:#E63946;
                        -fx-text-fill:white;
                        -fx-font-weight:bold;
                        -fx-background-radius:8;
                        -fx-cursor:hand;"/>



                <Button text="Actualizar"
                        onAction="#actualizarAsignacion"
                        prefWidth="120"
                        style="
                        -fx-background-color:#E63946;
                        -fx-text-fill:white;
                        -fx-font-weight:bold;
                        -fx-background-radius:8;
                        -fx-cursor:hand;"/>



                <Button text="Eliminar"
                        onAction="#eliminarAsignacion"
                        prefWidth="120"
                        style="
                        -fx-background-color:#333333;
                        -fx-text-fill:white;
                        -fx-font-weight:bold;
                        -fx-background-radius:8;
                        -fx-cursor:hand;"/>



                <Button text="Limpiar"
                        onAction="#limpiarCampos"
                        prefWidth="120"
                        style="
                        -fx-background-color:#333333;
                        -fx-text-fill:white;
                        -fx-font-weight:bold;
                        -fx-background-radius:8;
                        -fx-cursor:hand;"/>


            </HBox>




            <Separator/>



            <Label text="TABLA DE ASIGNACIONES"
                   alignment="CENTER"
                   maxWidth="650"
                   style="
                   -fx-text-fill:white;
                   -fx-font-size:17px;
                   -fx-font-weight:bold;"/>




            <TableView fx:id="tablaAsignaciones"
                       prefHeight="150"
                       prefWidth="650"
                       style="
                       -fx-background-color:#2B2B2B;
                       -fx-border-color:#E63946;
                       -fx-border-radius:8;">


                <columns>


                    <TableColumn fx:id="colId"
                                 text="ID"
                                 prefWidth="50"/>



                    <TableColumn fx:id="colCliente"
                                 text="Cliente"
                                 prefWidth="140"/>



                    <TableColumn fx:id="colRutina"
                                 text="Rutina"
                                 prefWidth="140"/>



                    <TableColumn fx:id="colInicio"
                                 text="Inicio"
                                 prefWidth="100"/>



                    <TableColumn fx:id="colFin"
                                 text="Fin"
                                 prefWidth="100"/>



                    <TableColumn fx:id="colEstado"
                                 text="Estado"
                                 prefWidth="120"/>


                </columns>


            </TableView>


        </VBox>


    </children>


</Pane>