<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>

<Pane prefHeight="500.0" prefWidth="600.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gymapp.controllers.ClientesController">

    <children>

        <Label layoutX="190.0"
               layoutY="20.0"
               text="GESTIÓN DE CLIENTES"
               style="-fx-font-size:18px; -fx-font-weight:bold;"/>

        <Label layoutX="30.0"
               layoutY="70.0"
               text="Nombre"/>

        <TextField fx:id="txtNombre"
                   layoutX="30.0"
                   layoutY="90.0"
                   prefWidth="220"/>

        <Label layoutX="30.0"
               layoutY="130.0"
               text="Edad"/>

        <TextField fx:id="txtEdad"
                   layoutX="30.0"
                   layoutY="150.0"
                   prefWidth="100"/>

        <Label layoutX="30.0"
               layoutY="190.0"
               text="Peso (kg)"/>

        <TextField fx:id="txtPeso"
                   layoutX="30.0"
                   layoutY="210.0"
                   prefWidth="100"/>

        <Button layoutX="30.0"
                layoutY="260.0"
                text="Guardar"
                onAction="#guardarCliente"/>

        <Button layoutX="120.0"
                layoutY="260.0"
                text="Actualizar"
                onAction="#actualizarCliente"/>

        <Button layoutX="235.0"
                layoutY="260.0"
                text="Eliminar"
                onAction="#eliminarCliente"/>

        <Button layoutX="340.0"
                layoutY="260.0"
                text="Limpiar"
                onAction="#limpiarCampos"/>

        <Label layoutX="215.0"
               layoutY="315.0"
               text="TABLA DE CLIENTES"
               style="-fx-font-weight:bold;"/>

        <TableView fx:id="tablaClientes"
                   layoutX="20.0"
                   layoutY="340.0"
                   prefHeight="140.0"
                   prefWidth="560.0">

            <columns>

                <TableColumn fx:id="colId"
                             prefWidth="60"
                             text="ID"/>

                <TableColumn fx:id="colNombre"
                             prefWidth="220"
                             text="Nombre"/>

                <TableColumn fx:id="colEdad"
                             prefWidth="120"
                             text="Edad"/>

                <TableColumn fx:id="colPeso"
                             prefWidth="160"
                             text="Peso"/>

            </columns>

        </TableView>

    </children>

</Pane>